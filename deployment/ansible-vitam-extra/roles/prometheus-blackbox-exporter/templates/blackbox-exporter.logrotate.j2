{{ ansible_managed | comment }}

{{ vitam_defaults.folder.root_path }}/log/blackbox_exporter/blackbox-exporter.log {
        daily
        rotate {{ prometheus.blackbox_exporter.history_days | default(30) }}
        copytruncate
        dateext
        dateformat -%Y-%m-%d
        dateyesterday
        extension .log
        compress
        delaycompress
        notifempty
        missingok
}
