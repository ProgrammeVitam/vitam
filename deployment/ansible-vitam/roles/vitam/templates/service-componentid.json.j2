{
  "service": {
{% if vitam_struct.vitam_component == vitam.offer.vitam_component %}
    "name": "{{ offer_conf }}",
    "address": "{{ ip_wan | default(ip_service) }}",
{% else %}
    "name": "{{ vitam_struct.vitam_component }}",
    "address": "{{ ip_service }}",
{% endif %}
    "port": {{ vitam_struct.port_service }},
    "enable_tag_override": false,
{% if vitam_struct.vitam_component == vitam.storage.vitam_component %}
    "tags": ["vitam", "{{ vitam_struct.vitam_component }}", "{{ vitam_struct.vitam_component }}-{{ groups.hosts_storage.index(inventory_hostname) + 1 }}"],
{% else %}
    "tags": ["vitam", "{{ vitam_struct.vitam_component }}"],
{% endif %}
    "checks": [
      {
        "name": "{{ vitam_struct.vitam_component }} : business service check",
        "notes": "HTTP{% if vitam_struct.https_enabled | bool %}S{% endif %} port opened",
        "tcp": "{{ ip_service }}:{{ vitam_struct.port_service }}",
        "interval": "{{ vitam_struct.consul_business_check | default(consul_business_check) }}s"
      }
      ,{
        "name": "{{ vitam_struct.vitam_component }} : admin service check",
        "notes": "Status admin : /admin/v1/status",
        "http": "http://{{ ip_admin }}:{{ vitam_struct.port_admin }}/admin/v1/status",
        "interval": "{{ vitam_struct.consul_admin_check | default(consul_admin_check) }}s"
      }
{% if not vitam_struct.https_enabled | bool and vitam_struct.vitam_component not in [vitam.elastic_kibana_interceptor.vitam_component, vitam.security_internal.vitam_component, vitam.ihm_demo.vitam_component, vitam.ihm_recette.vitam_component, vitam.library.vitam_component] %}
      ,{
        "name": "{{ vitam_struct.vitam_component }} : http business service check",
        "notes": "Status business : /{{ vitam_struct.baseuri }}/v1/status",
        "http": "http://{{ ip_service }}:{{ vitam_struct.port_service }}/{{ vitam_struct.baseuri }}/v1/status",
        "interval": "{{ vitam_struct.consul_business_check | default(consul_business_check) }}s"
      }
{% endif %}
{% if vitam_struct.vitam_component == vitam.security_internal.vitam_component %}
      ,{
        "name": "{{ vitam_struct.vitam_component }} : http business service check",
        "notes": "Status business : /status",
        "http": "http://{{ ip_service }}:{{ vitam_struct.port_service }}/status",
        "interval": "{{ vitam_struct.consul_business_check | default(consul_business_check) }}s"
      }
{% endif %}
{% if vitam_struct.vitam_component in [vitam.worker.vitam_component, vitam.ingest_external.vitam_component, vitam.collect_internal.vitam_component] %}
      ,{
        "name": "Siegfried check",
        "notes": "Is siegfried running ?",
        "tcp": "localhost:{{ siegfried.port }}",
        "interval": "{{ siegfried.consul_check }}s"
      }
{% endif %}
{% if vitam_struct.engine is defined and install_mode != "container" %}
      ,{
        "name": "Antivirus check",
        "notes": "Is {{ vitam_struct.engine }} running ?",
        "args": ["{{ vitam_folder_conf }}/scan-{{ vitam_struct.engine }}.sh","{{ vitam_folder_conf }}/scan-{{ vitam_struct.engine }}.sh"],
        "interval": "30s",
        "timeout": "5s"
      }
{% endif %}
    ]
  }
}
