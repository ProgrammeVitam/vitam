    {
      "id": "nhg4CKZanaexxkdVgTq-3",
      "type": "text",
      "x": 2025.6988002897174,
      "y": 1492.8079557486967,
      "width": 637.939453125,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 90,
      "groupIds": [],
