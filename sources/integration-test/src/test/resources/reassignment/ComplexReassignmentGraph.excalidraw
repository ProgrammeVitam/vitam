      "index": "b3n",
      "roundness": null,
      "seed": 433276676,
      "version": 559,
      "versionNonce": 1186277522,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1776172568384,
      "link": null,
      "locked": false,
      "text": "Test réaffectaction partielle (Unit 10 + GOT_7 seule) KO\nTest opi 6 préservation KO\nTest Opi 3 (got avec rattachement) KO \nTest Opi 4 (binaire rattaché ailleurs) KO\n\nTest Opi1 + Opi 2 SP2 ==> SP1 : OK uniquement OPI2\nTest OPI1 + OPI2 SP2 ==> SP4 : OK (création de summary SP4)\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Test réaffectaction partielle (Unit 10 + GOT_7 seule) KO\nTest opi 6 préservation KO\nTest Opi 3 (got avec rattachement) KO \nTest Opi 4 (binaire rattaché ailleurs) KO\n\nTest Opi1 + Opi 2 SP2 ==> SP1 : OK uniquement OPI2\nTest OPI1 + OPI2 SP2 ==> SP4 : OK (création de summary SP4)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
