    <rng:element name="ArchiveTransfer">
      <rng:zeroOrMore>
        <rng:attribute>
          <rng:anyName>
            <rng:except>
              <rng:nsName/>
              <rng:nsName ns=""/>
            </rng:except>
          </rng:anyName>
        </rng:attribute>
      </rng:zeroOrMore>
      <rng:optional>
        <rng:attribute name="id">
          <rng:data type="ID"/>
        </rng:attribute>
      </rng:optional>
      <rng:element name="Comment">
        <rng:value type="string">English Comment</rng:value>
      </rng:element>
      <rng:element name="Comment">
        <rng:value type="string">Commentaire par défaut</rng:value>
      </rng:element>
      <rng:element name="Comment">
        <rng:value type="string">Commentaire français</rng:value>
      </rng:element>
      <rng:element name="Comment">
        <rng:value type="string">Deutsch Kommentare</rng:value>
      </rng:element>
      <rng:element name="Date">
        <rng:data type="dateTime"/>
      </rng:element>
