	<artifactId>vitam-package</artifactId>
	<packaging>pom</packaging>
	<name>VITAM Package</name>
	<description>Packaging VITAM</description>

	<build>
		<plugins>
			<!-- download dependencies for signing rpms -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-dependencies-rpm</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeGroupIds>fr.gouv.vitam</includeGroupIds>
							<includeTypes>rpm</includeTypes>
							<outputDirectory>${basedir}/../rpm/vitam-product/target/</outputDirectory>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
						</configuration>
					</execution>
					<execution>
						<id>copy-dependencies-deb</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeGroupIds>fr.gouv.vitam</includeGroupIds>
							<includeTypes>deb</includeTypes>
							<outputDirectory>${basedir}/../deb/vitam-product/target/</outputDirectory>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>false</overWriteSnapshots>
							<overWriteIfNewer>true</overWriteIfNewer>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${maven.exec.version}</version>
				<executions>
					<!-- rpm -->
					<execution>
						<id>Build native vitam-product rpm</id>
						<phase>validate</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>../rpm/vitam-product/build-all-docker.sh</executable>
						</configuration>
					</execution>
					<execution>
						<id>Get native vitam-external rpm</id>
						<phase>validate</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>../rpm/vitam-external/build_repo.sh</executable>
						</configuration>
					</execution>
					<!-- debian -->
					<execution>
						<id>Build native vitam-product deb</id>
						<phase>validate</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>../deb/vitam-product/build-all.sh</executable>
						</configuration>
					</execution>
					<execution>
						<id>Get native vitam-external deb</id>
						<phase>validate</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>../deb/vitam-external/build_repo.sh</executable>
						</configuration>
					</execution>

					<!-- remove useless & dangerous configuration -->
					<execution>
						<id>Remove vitam certificates</id>
						<phase>compile</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>./remove_user_certificates.sh</executable>
						</configuration>
					</execution>
					<!-- empty vitam-griffins list -->
					<execution>
						<id>Remove vitam griffins</id>
						<phase>compile</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>./remove_griffins.sh</executable>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${maven.exec.version}</version>
				<!-- sign RPM -->
				<executions>
					<execution>
						<id>sign RPM</id>
						<phase>package</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>./sign_rpm.sh</executable>
						</configuration>
					</execution>
					<!-- sign DEB -->
					<execution>
						<id>sign DEB</id>
						<phase>package</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>./sign_deb.sh</executable>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- generate assemblies -->
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>assembly</id>
						<phase>package</phase>
						<configuration>
							<appendAssemblyId>true</appendAssemblyId>
							<tarLongFileMode>posix</tarLongFileMode>
							<descriptors>
								<descriptor>${basedir}/assembly-full.xml</descriptor>
								<descriptor>${basedir}/assembly-deb.xml</descriptor>
								<descriptor>${basedir}/assembly-rpm.xml</descriptor>
								<descriptor>${basedir}/assembly-deployment.xml</descriptor>
								<descriptor>${basedir}/assembly-doc.xml</descriptor>
							</descriptors>
						</configuration>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

