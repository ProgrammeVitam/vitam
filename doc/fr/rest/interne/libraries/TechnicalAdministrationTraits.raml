#%RAML 1.0 Library

usage: |
  Use to define global headers for Technical Administration
uses:
  StandardTypes: StandardTypes.raml
  StandardTraits: StandardTraits.raml

traits:
  LogbookReconstruction:
    displayName: Logbook Reconstruction
    description: Logbook Reconstruction
    is: [ StandardTraits.StandardOptionalHeader, StandardTraits.StandardHeader200, StandardTraits.StandardHeader206,
      StandardTraits.StandardHeader401, StandardTraits.StandardHeader404, StandardTraits.StandardHeader412 ]
    body:
      application/json:
        description: Logbook Reconstruction Query
        example: !include examples/logbookReconstructionQuery.json
    responses:
      200:
        body:
          application/json:
            description: Logbook Reconstruction Response
            example: !include examples/logbookReconstructionResponse.json
  MetadataReconstruction:
    displayName: Metadata Reconstruction
    description: Metadata Reconstruction
    is: [ StandardTraits.StandardOptionalHeader, StandardTraits.StandardHeader200, StandardTraits.StandardHeader206,
      StandardTraits.StandardHeader401, StandardTraits.StandardHeader404, StandardTraits.StandardHeader412 ]
    body:
      application/json:
        description: Metadata Reconstruction query
        example: !include examples/metadataReconstructionQuery.json
    responses:
      200:
        body:
          application/json:
            description: Metadata Reconstruction Response
            example: !include examples/metadataReconstructionResponse.json

  LogbookConsistency:
    displayName: Logbook Consistency
    description: Logbook Consistency
    is: [ StandardTraits.StandardOptionalHeader, StandardTraits.StandardHeader200, StandardTraits.StandardHeader206,
      StandardTraits.StandardHeader401, StandardTraits.StandardHeader404, StandardTraits.StandardHeader412 ]
    responses:
      200:
        description: |
          Retourne OK en cas de succès de la cohérence
      500:
        description: |
          Retourne Internal Server Error en cas d'échec de la cohérence

  AdminReindex:
    description: |
      Response model for reindexation order.

      Le paramètre indexationStartDate est optionnel et ne peut être utilisé qu'avec les collections UNIT et OBJECTGROUP.
      Si indexationStartDate est fourni avec d'autres collections, une erreur 400 sera retournée.
    is: [ StandardTraits.StandardOptionalHeader,
      StandardTraits.StandardHeader400 ]
    body:
      application/json:
        description: |
          Contient la requête de réindexation au format JSON.

          Paramètres:
          - collection: nom de la collection à réindexer
          - tenants: liste des tenants concernés
          - indexationStartDate (optionnel): date de début pour la réindexation incrémentale.
            Ce paramètre n'est autorisé que pour les collections UNIT et OBJECTGROUP.

            Format attendu:
            - indexationStartDate doit être fourni au format strict: yyyy-MM-dd (exemple: 2025-12-30).
            - Tout autre format sera rejeté avec une erreur 400.

            Note: Si indexationStartDate est rempli, aucun nouvel index n'est créé et l'index actuel est réutilisé.
        example: !include examples/reindexation.json
    responses:
      200:
        description: |
          Retourne OK en cas de succès de réindexation
        body:
          application/json:
            description: Reindexation accepted
            example: !include examples/reindexationResponse.json
      400:
        description: |
          Retourne BAD_REQUEST dans les cas suivants:
          - Paramètres manquants ou invalides
          - indexationStartDate fourni avec une collection autre que UNIT ou OBJECTGROUP
        body:
          application/json:
            description: |
              Erreur de validation des paramètres
            example: |
              {
                "httpCode": 400,
                "code": "BAD_REQUEST",
                "context": "FUNCTIONAL_ADMINISTRATION",
                "state": "code_vitam",
                "message": "Indexation with start date is only allowed for UNIT and OBJECTGROUP collections, but was requested for collection: FORMATS",
                "description": "Invalid indexation parameters."
              }

  AdminAlias:
    description: Response model for switch order
    is: [ StandardTraits.StandardOptionalHeader,
      StandardTraits.StandardHeader400 ]
    body:
      application/json:
        description: Contient la requête de switch au format JSON.
        example: !include examples/switch.json
    responses:
      200:
        description: |
          Retourne OK en cas de succès de switch
        body:
          application/json:
            description: Reindexation accepted
            example: !include examples/switchResponse.json
